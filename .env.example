# gmail-cleanup — environment keys (no values).
# Copy to .env and fill in. .env is git-ignored; never commit it.
# Non-secret settings belong in the project's config file, not here.

# Google OAuth desktop-client JSON: choose a path or supply the JSON value.
# GMAIL_CREDENTIALS_PATH="/path/to/oauth-client.json"
# GMAIL_CLIENT_CONFIG_JSON=
#
# Optional, for noninteractive CLI use. Contains a reusable refresh token.
# `gmail export-credentials --account ...` can write this key to .env.
# GMAIL_AUTHORIZED_USER_JSON=

# Local web UI: local application login is separate from Google authorization.
# Set the provider to local explicitly; other providers are not implemented.
# GMAIL_AUTH_PROVIDER=
# GMAIL_DEV_USERNAME=
# GMAIL_DEV_PASSWORD=
# GMAIL_ENCRYPTION_KEY=
# Google OAuth web-application client JSON file, used only by the web UI.
# GMAIL_WEB_CREDENTIALS_PATH=

# --- markdown-tools publishing (md2conf / md2jira) — keys only, never values ---
# Used when you publish docs/ to Confluence or sync the backlog to Jira. The
# non-secret settings (space, folder, project, labels) live in the COMMITTED
# markdown-to-*.toml files, and their state in .md2conf/ + .md2jira/ (committed).
# Base URL INCLUDES /wiki (Confluence Cloud lives under /wiki).
# CONFLUENCE_BASE_URL=
# CONFLUENCE_USER_EMAIL=
# CONFLUENCE_API_TOKEN=
# JIRA_BASE_URL=
# JIRA_USER_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
